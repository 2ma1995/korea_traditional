# 실제 값은 여기에 적지 않는다. 이 파일은 "무엇이 필요한지"만 알려주는 목록이다.
#
# 로컬 개발  web/.env.local 에 복사해서 채운다 (.gitignore의 .env* 에 걸려 커밋되지 않음)
# 배포       Vercel > Settings > Environment Variables 에 넣는다
#            Production / Preview / Development 세 환경 모두 체크해야 한다
#
# 주의: 이름 앞에 NEXT_PUBLIC_ 을 붙이면 브라우저 번들에 그대로 들어간다.
#       아래 값들은 전부 서버에서만 쓰므로 절대 붙이지 않는다.

# ── 카페24 ────────────────────────────────────────────────
# 개발자센터(developers.cafe24.com) > Apps > App 관리 에서 발급
# Redirect URI 는 https 만 허용된다 → 인증은 배포 환경에서만 테스트할 수 있다
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# API 버전 헤더. 비워두면 코드의 기본값을 쓴다
CAFE24_API_VERSION=

# ── Supabase ──────────────────────────────────────────────
# 대시보드 > Settings > API
# anon 키가 아니라 service_role 키다. RLS를 정책 없이 켜 뒀으므로
# anon 키로는 아무것도 읽거나 쓸 수 없다
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 배포 주소 ─────────────────────────────────────────────
# Redirect URI 를 만들 때 쓴다. Vercel에서는 자동으로 잡히므로 보통 비워둔다.
# 자체 도메인을 붙이면 그 주소를 넣고, 카페24 개발자센터의 Redirect URI 도 같이 바꿔야 한다
SITE_ORIGIN=
